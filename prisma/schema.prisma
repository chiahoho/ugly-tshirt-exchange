generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Group {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  adminToken String   @unique
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
  members    Member[]
}

model Member {
  id           String   @id @default(cuid())
  name         String
  tshirtSize   String
  secretToken  String   @unique
  groupId      String
  assignedToId String?  @unique
  createdAt    DateTime @default(now())

  group      Group   @relation(fields: [groupId], references: [id])
  assignedTo Member? @relation("Assignment", fields: [assignedToId], references: [id])
  assignedBy Member? @relation("Assignment")
}
